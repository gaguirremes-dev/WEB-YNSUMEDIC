# ============================================================
#  YNSUMEDIC — .htaccess  |  Apache 2.4+
#  Seguridad, caché, compresión y HTTPS redirect
# ============================================================

Options -Indexes
ServerSignature Off

# ── Redirigir HTTP → HTTPS ──────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirigir www → sin www (opcional, descomentar si se prefiere)
  # RewriteCond %{HTTP_HOST} ^www\.ynsumedic\.com [NC]
  # RewriteRule ^ https://ynsumedic.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Compresión GZIP ─────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
</IfModule>

# ── Cache de Navegador ──────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — sin caché (contenido dinámico)
  ExpiresByType text/html                 "access plus 0 seconds"

  # CSS / JS — 1 mes
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType text/javascript           "access plus 1 month"

  # Imágenes — 6 meses
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/gif                 "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Fuentes — 1 año
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff     "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"

  # Video — 1 mes
  ExpiresByType video/mp4                 "access plus 1 month"
  ExpiresByType video/webm                "access plus 1 month"

  # Manifest / JSON
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ── Headers de Seguridad ────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS — forzar HTTPS por 1 año
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Evitar clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Evitar MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # XSS Protection
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  # Eliminar header de servidor
  Header unset Server
  Header unset X-Powered-By

  # Cache-Control para HTML
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache inmutable para assets con hash
  <FilesMatch "\.(css|js|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# ── Content Security Policy ─────────────────────────────────
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none';"
</IfModule>

# ── Tipos MIME ──────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript          .js .mjs
  AddType text/css                        .css
  AddType image/webp                      .webp
  AddType image/svg+xml                   .svg .svgz
  AddType font/woff                       .woff
  AddType font/woff2                      .woff2
  AddType application/manifest+json       .webmanifest .json
  AddType video/mp4                       .mp4
  AddType video/webm                      .webm
</IfModule>

# ── Proteger archivos sensibles ─────────────────────────────
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|cpanel\.yml|composer\.json|package\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ── Errores personalizados ──────────────────────────────────
ErrorDocument 404 /404.html
ErrorDocument 403 /index.html
ErrorDocument 500 /index.html

# ── URLs amigables (extensión .html opcional) ───────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L,QSA]
</IfModule>
